# VeriBrand AI — Environment Configuration Example

# Server Environment
PORT=3000
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1

# SQLite Database Location (defaults to data/veribrand.db)
VERIBRAND_DB_PATH=data/veribrand.db

# Authentication Session Secret Salt
VERIBRAND_SALT=veribrand_ai_enterprise_salt_2026

# Optional Python Verification Engine Service URL
PYTHON_ENGINE_URL=http://localhost:8000
