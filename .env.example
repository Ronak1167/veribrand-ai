# VeriBrand AI - Environment Configuration Example

# Server Environment
PORT=3000
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1

# SQLite Database Location (defaults to data/veribrand.db)
VERIBRAND_DB_PATH=data/veribrand.db

# First-administrator bootstrap token. Generate at least 32 random characters.
VERIBRAND_BOOTSTRAP_TOKEN=replace-with-at-least-64-random-characters

# Optional Python Verification Engine Service
PYTHON_ENGINE_URL=http://localhost:8000
VERIBRAND_PYTHON_API_KEY=replace-with-at-least-64-random-characters
VERIBRAND_PYTHON_HOST=127.0.0.1
# Comma-separated exact origins; defaults to localhost:3000 and 127.0.0.1:3000.
# VERIBRAND_PYTHON_ALLOWED_ORIGINS=https://your-frontend.example

# Required only when enabling the optional postgres-tools Compose profile.
# Generate a unique secret; never use a sample/default password.
# POSTGRES_PASSWORD=replace-with-a-unique-long-random-secret
